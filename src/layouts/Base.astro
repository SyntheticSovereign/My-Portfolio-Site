---
import '../styles/global.css';
import { person } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const base = home ? '' : '/';
const brandWord = 'SyntheticSovereign';
const nav = [
  { href: `${base}#about`, label: 'About' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#projects`, label: 'Projects' },
  { href: `${base}#awards`, label: 'Awards' },
  { href: `${base}#skills`, label: 'Skills' },
  { href: `${base}#community`, label: 'Community' },
  { href: `${base}#contact`, label: 'Contact' },
];
const ogImage = new URL('/og.png?v=3', Astro.site).href;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c10" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Tanvir Ahmed Aadeef, detection engineer, over a live network of hosts and SIEMs." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('taa-booted')) document.documentElement.setAttribute('data-booted', '');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar" data-topbar>
      <div class="topbar-inner wrap">
        <a class="brand" href={home ? '#top' : '/'} aria-label={`${brandWord}: ${person.name}, home`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.2 20 5.4v6.1c0 5-3.4 8.7-8 10.3-4.6-1.6-8-5.3-8-10.3V5.4L12 2.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6.4 12.4h2.7l1.5-3.6 2.5 6.8 1.6-3.2h2.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="brand-name">{brandWord}</span>
        </a>

        <nav class="topnav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a class="link" href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>

        <div class="topbar-actions">
          <button class="icon-btn" type="button" data-sound aria-pressed="true" aria-label="Sound on. Turn interface sound off">
            <Icon name="sound-off" class="i-off" />
            <Icon name="sound-on" class="i-on" />
          </button>
          <a class="btn btn-solid topbar-cta" href={person.resume} download>
            <Icon name="download" /> Download résumé
          </a>
          <button class="icon-btn menu-btn" type="button" data-menu aria-expanded="false" aria-controls="menu" aria-label="Open menu">
            <Icon name="menu" />
          </button>
        </div>
      </div>
    </header>

    <div class="menu" id="menu" data-menu-panel hidden>
      <nav aria-label="Mobile">
        <ul>
          {nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-solid" href={person.resume} download><Icon name="download" /> Download résumé</a>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>© 2026 {person.name} · Melbourne, Australia</p>
        <p class="footer-links">
          <a class="link" href={person.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
          <a class="link" href={person.github} rel="noopener noreferrer" target="_blank">GitHub</a>        </p>
      </div>
    </footer>

    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .topbar[data-scrolled] {
    background: rgb(var(--bg-rgb) / 0.86);
    border-bottom-color: var(--line);
    backdrop-filter: blur(10px);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--resolved);
  }
  .brand-mark svg {
    width: 26px;
    height: 26px;
  }
  .brand-name {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .topnav {
    margin-left: auto;
  }
  .topnav ul {
    display: flex;
    gap: clamp(16px, 1.6vw, 26px);
  }
  .topnav a {
    color: var(--ink-2);
    font-size: 0.93rem;
    transition: color 160ms ease;
  }
  .topnav a:hover {
    color: var(--ink);
  }
  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    background: rgb(var(--raised-rgb) / 0.7);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      transform 120ms var(--ease-out);
  }
  .icon-btn:active {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      color: var(--ink);
      border-color: var(--muted);
    }
  }
  .icon-btn :global(svg) {
    width: 18px;
    height: 18px;
  }
  .icon-btn :global(.i-on) {
    display: none;
  }
  .icon-btn[aria-pressed='true'] {
    color: var(--resolved);
  }
  .icon-btn[aria-pressed='true'] :global(.i-on) {
    display: block;
  }
  .icon-btn[aria-pressed='true'] :global(.i-off) {
    display: none;
  }
  .menu-btn {
    display: none;
  }

  .menu {
    position: fixed;
    inset: var(--nav-h) 0 0;
    z-index: 49;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px var(--gutter);
    background: var(--bg);
  }
  .menu[hidden] {
    display: none;
  }
  .menu ul {
    display: grid;
    gap: 4px;
  }
  .menu li a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--step-2);
    font-weight: 560;
    text-decoration: none;
  }

  .footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .footer-inner p {
    display: flex;
    align-items: center;
  }

  @media (max-width: 1180px) {
    .topnav,
    .topbar-cta {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .topbar-actions {
      margin-left: auto;
    }
  }
</style>
