---
import { method } from '../data/site';
---

<section class="section" id="method" data-ambient="signal" aria-labelledby="method-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="method-title">How I work</h2>
      <p>The same loop at work and at home: every detection has to survive the attack it was written for.</p>
    </div>
    <ol class="steps">
      {method.map((m) => (
        <li class="step">
          <span class="step-n mono">{m.step}</span>
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 22px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 38px;
    right: -17px;
    width: 18px;
    height: 1px;
    background: var(--line-hi);
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .step:first-child .step-n {
    border-color: rgb(255 91 79 / 0.6);
    color: var(--attack);
  }
  .step:nth-child(2) .step-n,
  .step:nth-child(3) .step-n {
    border-color: rgb(77 163 255 / 0.55);
    color: var(--detect);
  }
  .step:last-child .step-n {
    border-color: rgb(62 214 142 / 0.6);
    color: var(--resolved);
  }
  .step h3 {
    margin-top: 6px;
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
  .step p {
    color: var(--ink-2);
    line-height: 1.55;
  }
  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .step::after {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
