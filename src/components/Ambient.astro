<canvas class="ambient" data-ambient-canvas aria-hidden="true"></canvas>

<script>
  import { reducedMotion } from '../scripts/shell';
  import type { Shape } from '../scripts/ambient';

  async function init() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-ambient-canvas]');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-ambient]')];
    if (!canvas || !sections.length) return;

    let api: import('../scripts/ambient').AmbientApi | null = null;
    try {
      const mod = await import('../scripts/ambient');
      api = mod.createAmbient(canvas, { reduced: reducedMotion(), compact: window.innerWidth < 760 });
    } catch {
      api = null;
    }
    if (!api) {
      canvas.remove();
      return;
    }

    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const heroCanvas = hero?.querySelector<HTMLElement>('.hero-canvas') ?? null;

    type Stop = { shape: Shape; from: number; to: number };
    let stops: Stop[] = [];
    let heroEnd = 0;
    let pageEnd = 1;

    const measure = () => {
      const vh = window.innerHeight;
      const top = (el: HTMLElement) => el.getBoundingClientRect().top + window.scrollY;
      stops = [];
      if (hero) {
        heroEnd = top(hero) + hero.offsetHeight;
        stops.push({ shape: 'network', from: 0, to: Math.max(0, heroEnd - vh * 0.3) });
      }
      for (const s of sections) {
        const t = top(s);
        stops.push({ shape: s.dataset.ambient as Shape, from: t + vh * 0.2, to: t + s.offsetHeight - vh * 0.5 });
      }
      for (const st of stops) st.to = Math.max(st.to, st.from);
      pageEnd = Math.max(1, document.documentElement.scrollHeight - vh);
    };

    const ease = (q: number) => q * q * (3 - 2 * q);
    let on = false;
    let queued = false;

    const update = () => {
      queued = false;
      const y = window.scrollY;
      const vh = window.innerHeight;

      const handoff = hero ? Math.min(1, Math.max(0, (y - (heroEnd - vh * 0.8)) / (vh * 0.45))) : 1;
      heroCanvas?.style.setProperty('--handoff', handoff.toFixed(3));
      canvas.style.setProperty('--reveal', handoff.toFixed(3));

      const nowOn = handoff > 0 && !document.hidden;
      if (nowOn !== on) {
        on = nowOn;
        canvas.toggleAttribute('data-on', on);
        api!.setActive(on);
      }

      let a = stops[0];
      let b = stops[0];
      let q = 0;
      for (let i = 0; i < stops.length; i++) {
        const s = stops[i];
        if (y <= s.to) {
          if (i === 0 || y >= s.from) {
            a = b = s;
            q = 0;
          } else {
            a = stops[i - 1];
            b = s;
            q = ease(Math.min(1, Math.max(0, (y - a.to) / Math.max(1, s.from - a.to))));
          }
          break;
        }
        a = b = s;
      }
      api!.scrub(a.shape, b.shape, a === b ? 0 : q, y / pageEnd);
    };

    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    measure();
    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      request();
    });
    new ResizeObserver(() => {
      measure();
      request();
    }).observe(document.body);
    document.addEventListener('visibilitychange', update);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init, { once: true });
</script>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.4) 32%, #000 62%);
  }
  .ambient[data-on] {
    opacity: var(--reveal, 1);
  }
  @media (max-width: 900px) {
    .ambient {
      mask-image: none;
    }
    .ambient[data-on] {
      opacity: calc(var(--reveal, 1) * 0.6);
    }
  }
</style>
